# Local game collections and generated outputs.
/SRC/*
!/SRC/.gitkeep
/DST/*
!/DST/.gitkeep
*.log
OptiMiyoo_*.csv
__pycache__/
*.pyc
/dist/
/data/

# Local development evidence and candidate packages are not app source.
/artifacts/
/scratch/
/verification/
/release-candidates/
/OptiMiyoo-[0-9]*.[0-9]*.[0-9]*/
/OptiMiyoo-RC[0-9]*/
/OptiMiyoo-*-windows.zip
/OptiMiyoo-*-windows.zip.sha256

# Interpreter caches and desktop metadata.
.venv/
venv/
.pytest_cache/
.DS_Store
Thumbs.db
desktop.ini

# Local runtime selection can contain a personal absolute path.
/app/ZX/runtime-path.txt

# Local credentials, signing material, and crash dumps are never project assets.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.dmp
*.pdb
.git-credentials
.netrc
_netrc
.ssh/
id_rsa
id_ed25519

# SD configuration backups can contain local settings.
OptiMiyoo_Backup_*/
OptiMiyoo_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
